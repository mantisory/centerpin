function calculateTax(country, province) {
  let taxTotal,
    taxRate,
    shippingEU,
    shippingUS,
    curShipping,
    totalShipping = 0;

  if (country == "OT") {
    shippingEU = $(".order-total").text().replace("$", "") * 0.1;
    // curShipping = $("#s-h").text().replace("$", "") * 1.0;
    curShipping = handlingTotal;
    totalShipping = (curShipping + shippingEU).toFixed(2);
    $("#s-h").text("$" + totalShipping);
    $("input[name='handling_cart']").val(totalShipping);
    taxTotal = 0;
  } else if (country == "CA") {
    taxRate =
      province == "AB" ||
      province == "BC" ||
      province == "MB" ||
      province == "NW" ||
      province == "NN" ||
      province == "QC" ||
      province == "SK" ||
      province == "YK"
        ? 0.05
        : province == "ON"
        ? 0.13
        : 0.15;

    taxTotal =
      (handlingTotal + parseFloat($(".order-total").text().replace("$", ""))) *
      taxRate;
  } else if (country == "US") {
    let order = $(".order-total").text().replace("$", "");
    let shippingCTLAmount = parseFloat($("#s-h").text().replace("$", ""));
    shippingCTLAmount += 5;

    if (order > 250) {
      shippingCTLAmount = 32.99;
    }
    //console.group(shippingCTLAmount);
    $("#s-h").text("$" + shippingCTLAmount.toFixed(2));
    $("input[name='handling_cart']").val(shippingCTLAmount);
    taxTotal = 0;
  }
  $(".shipping-handling-container").removeClass("sh-hidden");
  return taxTotal;
}
