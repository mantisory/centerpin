    // if ($(".expedited-shipping-rates").data("open")) {
    //   $(".expedited-shipping-rates").data("open", false);
    //   $(".expedited-shipping-rates").slideUp();
    // } else {
    //   $(".expedited-shipping-rates").data("open", true);
    //   $(".expedited-shipping-rates").slideDown();
    // }
  });

  /* add taxes based on country */
  $("#tax-country").on("change", function () {
    $(".checkout-button")
      .prop("disabled", true)
      .addClass(" paypal-button-disabled");
    document.getElementById("tax-province").selectedIndex = 0;
    let country = $(this).val();
    $("#s-h").text("$" + handlingTotal.toFixed(2));
    $("input[name='handling_cart']").val(handlingTotal.toFixed(2));
    let taxTotal = 0;
    $("#tax-amount").text("");
    if (country == "CA") {
      $(".summary-tax-province-container ").removeClass("province-hidden");
    } else {
      $(".summary-tax-province-container ").addClass("province-hidden");
      if (country != "") {
        taxTotal = calculateTax(country);
        $("#tax-amount").text("$" + taxTotal.toFixed(2));
        $("#tax-cart").val(taxTotal.toFixed(2));
      }
      let totalAmount = (
        parseFloat($('[name="handling_cart"]').val()) +
        taxTotal +
        parseFloat($(".order-total").text().replace("$", ""))
      ).toFixed(2);
      $("#total-amount-with-tax").text("$" + totalAmount);
      $(".checkout-button")
        .prop("disabled", false)
        .removeClass(" paypal-button-disabled");
    }
  });
  $("#tax-province").on("change", function () {
    let province = $(this).val();
    let country = $("#tax-country").val();
    let taxTotal = 0;

    if (province != "") {
      taxTotal = calculateTax(country, province);
      $("#tax-amount").text("$" + taxTotal.toFixed(2));
      $("#tax-cart").val(taxTotal.toFixed(2));
    }
    let totalAmount = (
      parseFloat($('[name="handling_cart"]').val()) +
