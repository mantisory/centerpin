window.onload = function () {
  var banner = document.getElementById("banner");
  var activeFirstImage = 0; // Math.ceil(Math.random() * 4);
  //setTimeout(function () {
  $(banner).find("img").addClass("banner-logo");
  for (var i = 0; i < 3; i++) {
    $(banner).append(
      "<img class='cycle-image " +
        (i === activeFirstImage ? "active" : "") +
        "' src='images/banner-pics/image" +
        (i + 1) +
        ".png'>"
    );
  }
  //}, 15000);

  try {
    document.getElementById("tax-country").selectedIndex = 0;
  } catch (e) {
    //console.log(e);
  }
};

function cycleImages() {
  var $active = $(".active");
  var $next =
    $active.next().length > 0
      ? $active.next()
      : $(".banner-div .cycle-image:first");
  $next.css("z-index", 2); //move the next image up the pile
  $active.fadeOut(1500, function () {
    //fade out the top image
    $active.css("z-index", 1).show().removeClass("active"); //reset the z-index and unhide the image
    $next.css("z-index", 3).addClass("active"); //make the next image the top one
  });
}
$(document).ready(() => {
  //setTimeout(function () {
  //$(".banner-div").addClass("banner-div-loaded");
  setInterval("cycleImages()", 15500);
  //}, 15000);
  $("#discount_code").on("change", function () {
    console.log($(this).val());
    $.ajax({
      type: "POST",
      url: "./admin/db_functions.php",
      data: { action: "getDiscount", param1: $(this).val() },
      success: function (response) {
        console.log(response);
        if (Number.isInteger(Number(response))) {
          let orderTotal = parseFloat($(".order-total").text());
          let newOrderTotal = (
            orderTotal *
            ((100 - parseInt(response)) / 100)
          ).toFixed(2);
          $(".order-total").text(newOrderTotal);
          $("#discount_code").prop("disabled", true);
        } else {
          $("#discount_code")
            .val("")
            .attr("placeholder", "discount code not found");
        }
      },
    });
  });
  /****************************/
  //$("body").append(
  //  '<a href="shopping_cart.php" id="cart-button"> <img src="images/cart_icon.png"/><span>View Cart</span></a>'
  //);

  function isMobileScreenSize() {
    return window.innerWidth <= 768; // Example breakpoint for mobile
  }
  // Position the button using visualViewport
  function positionCartButton() {
    if (window.visualViewport && isMobileScreenSize()) {
      const vv = window.visualViewport;
      const button = document.getElementById("cart-button");

      // distance from edges (in CSS pixels, scaled)
      const offsetRight = 20;
      const offsetBottom = 20;

      // Place button relative to current visual viewport
      button.style.left =
        vv.pageLeft + vv.width - button.offsetWidth - offsetRight + "px";
      button.style.top =
        vv.pageTop + vv.height - button.offsetHeight - offsetBottom + "px";
    }
  }

  // Initial position
  positionCartButton();

  // Update when viewport changes (scroll, pinch zoom, resize)
  if (window.visualViewport) {
    window.visualViewport.addEventListener("resize", positionCartButton);
    window.visualViewport.addEventListener("scroll", positionCartButton);
  }

  // Example click event
  //$("#cart-button").on("click", function () {
  //  alert("Cart clicked!");
  //});
  /*****************************/

  // console.log($("#tax-country").val());
  // $("#tax-country option:first").prop("selected", true);
  let expeditedOpen = false;

  let cart = JSON.parse(localStorage.getItem("shopping-cart")) || [];
  if (cart.length > 0) {
    $(".shopping-cart-link").removeClass("cart-empty");
    let itemsPlural = cart.length === 1 ? " item)" : " items)";
    $(".shopping-cart-link")
      .find("span")
      .text("View Cart (" + cart.length + itemsPlural);
    $(".shopping-cart-sidebar")
      .find("span")
      .text("View Cart (" + cart.length + itemsPlural);

    //$("#cart-button")
    //  .addClass("cart-button-active")
    //  .find("span")
    //  .text("View Cart (" + cart.length + itemsPlural);
  } else {
    //console.log("cart button inactive");
    $(".shopping-cart-link").addClass("cart-empty");
  }

  $(".option-selector").change((e) => {
    let select = $(e.target);
    let selected = select.find(":selected");
    let text = selected.text();
    let itemModel = ".item_model_" + $(e.target).attr("name").slice(-1);

