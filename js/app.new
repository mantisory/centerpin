      parseFloat($(".order-total").text().replace("$", ""))
    ).toFixed(2);
    $("#total-amount-with-tax").text("$" + totalAmount);
    $(".checkout-button")
      .prop("disabled", false)
      .removeClass(" paypal-button-disabled");
  });
