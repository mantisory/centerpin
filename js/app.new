    // let nameIndex = $(namer).attr("name").slice(-1);
    let nameIndex = $(this).attr("name").slice(-1);

    $(this)
      .closest("form")
      .append('<input type="hidden" name="amount" value="" class="amount">');
    $(this)
      .closest("form")
      .append(
