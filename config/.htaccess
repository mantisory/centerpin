# Block direct web access to PHP config files (Stripe keys).
# The .json/.js files here are fetched by the browser and must stay reachable.
<FilesMatch "\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Tariff rates change often — never let browsers cache them.
<Files "tariff.config.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</Files>
